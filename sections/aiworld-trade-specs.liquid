<section class="trade-specs" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background:{{ section.settings.background }};"><div class="trade-container"><div class="trade-head"><p class="trade-kicker">{{ section.settings.kicker }}</p><h2 class="trade-heading">{{ section.settings.heading }}</h2><p class="trade-subheading">{{ section.settings.subheading }}</p></div><div class="trade-specs__grid"><div class="trade-specs__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width:1200 | image_tag: loading:'lazy', widths:'600,900,1200', sizes:'(min-width:990px) 50vw, 100vw', alt:section.settings.heading | escape }}{% endif %}</div><div class="trade-specs__list">{% for block in section.blocks %}<div class="trade-spec" style="--spec-icon-size:{{ block.settings.icon_size | default: 32 }}px;" {{ block.shopify_attributes }}>{% if block.settings.icon_image != blank %}<span class="trade-spec__icon">{{ block.settings.icon_image | image_url: width:96 | image_tag: class:'trade-spec__icon-image', loading:'lazy', widths:'32,64,96', sizes:'32px', alt:block.settings.title | escape }}</span>{% endif %}<div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div></div>{% endfor %}</div></div></div></section>
{% schema %}
{"name":"AIWORLD trade specs","tag":"section","class":"section-aiworld-trade-specs","settings":[{"type":"image_picker","id":"image","label":"Product image (recommended 1200 × 900 px)","info":"建议图片尺寸：1200 × 900 px，产品主体居中，背景透明或白色"},{"type":"text","id":"kicker","label":"Kicker","default":"SPECS AT A GLANCE"},{"type":"text","id":"heading","label":"Heading","default":"AIWORLD Screen X10"},{"type":"text","id":"subheading","label":"Subheading","default":"Everything you need to know."},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"range","id":"padding_top","min":0,"max":120,"step":4,"unit":"px","label":"Top spacing","default":48},{"type":"range","id":"padding_bottom","min":0,"max":120,"step":4,"unit":"px","label":"Bottom spacing","default":48}],"blocks":[{"type":"spec","name":"Specification","settings":[{"type":"image_picker","id":"icon_image","label":"PNG icon (recommended 96 × 96 px)","info":"建议使用透明 PNG，尺寸：96 × 96 px"},{"type":"range","id":"icon_size","label":"Icon size (px)","min":20,"max":64,"step":1,"unit":"px","default":32},{"type":"text","id":"title","label":"Title","default":"Screen Size"},{"type":"text","id":"text","label":"Text","default":"10.26 inches (HD)"}]}],"max_blocks":8,"presets":[{"name":"AIWORLD trade specs","blocks":[{"type":"spec","settings":{"title":"Screen Size","text":"10.26 inches (HD)"}},{"type":"spec","settings":{"title":"Compatibility","text":"Fits most cars, trucks, SUVs (12V-24V)"}},{"type":"spec","settings":{"title":"Connectivity","text":"Wireless CarPlay & Android Auto"}},{"type":"spec","settings":{"title":"Audio Output","text":"Built-in speaker, FM transmitter or AUX"}},{"type":"spec","settings":{"title":"Installation","text":"Plug and play (cigarette lighter)"}},{"type":"spec","settings":{"title":"What's Included","text":"Screen X10, mount, car charger, AUX cable, user manual"}}]}]}
{% endschema %}
