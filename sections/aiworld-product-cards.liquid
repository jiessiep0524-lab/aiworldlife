{{ 'aiworld-product.css' | asset_url | stylesheet_tag }}

<section
  class="aiworld-product-section aiworld-product-cards"
  style="--aiworld-section-bg: {{ section.settings.background_color }}; --aiworld-card-columns: {{ section.settings.columns }};"
>
  <div class="aiworld-product-section__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="aiworld-product-section__heading">
        {%- if section.settings.eyebrow != blank -%}<p class="aiworld-product-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="aiworld-product-card-grid">
      {%- for block in section.blocks -%}
        <article class="aiworld-product-card" style="--aiworld-card-bg: {{ block.settings.card_color }};" {{ block.shopify_attributes }}>
          <div class="aiworld-product-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.heading -}}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="aiworld-product-card__copy">
            {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="aiworld-product-button" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "商品推荐卡片组",
  "tag": "section",
  "class": "aiworld-product-cards-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why settle for less?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for a better drive." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Thoughtful details that make everyday driving feel simpler.</p>" },
    { "type": "select", "id": "columns", "label": "Cards per row", "options": [
      { "value": "2", "label": "2" },
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ], "default": "3" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "No more aftermarket drama" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A clean, flexible display that feels at home in any vehicle." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "card_color", "label": "Card color", "default": "#ffffff" }
      ]
    }
  ],
  "presets": [
    {
      "name": "商品推荐卡片组",
      "blocks": [
        { "type": "card", "settings": { "heading": "No more aftermarket drama", "text": "A clean, flexible display that feels at home in any vehicle." } },
        { "type": "card", "settings": { "heading": "New entertainment hub", "text": "Bring your favorite apps, music, and maps to every journey." } },
        { "type": "card", "settings": { "heading": "CarPlay & Android Auto", "text": "Connect your phone your way and keep the road in focus." } }
      ]
    }
  ]
}
{% endschema %}
