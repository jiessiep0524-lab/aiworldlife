<section class="trade-offer{% if section.settings.image != blank or section.settings.mobile_image != blank %} trade-offer--has-image{% endif %}" style="background:{{ section.settings.background }};padding-top:{% if section.settings.enable_top_spacing == false %}0{% else %}{{ section.settings.padding }}{% endif %}px;padding-bottom:{% if section.settings.enable_bottom_spacing == false %}0{% else %}{{ section.settings.padding }}{% endif %}px;">{% if section.settings.image != blank or section.settings.mobile_image != blank %}<div class="trade-offer__media">{% if section.settings.mobile_image != blank %}<picture><source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: section.settings.heading }}{% elsif section.settings.mobile_image != blank %}{{ section.settings.mobile_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '375,750,1100', sizes: '100vw', alt: section.settings.heading }}{% endif %}{% if section.settings.mobile_image != blank %}</picture>{% endif %}</div>{% endif %}<div class="trade-container trade-offer__inner"><div class="trade-offer__copy"><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="trade-offer__price">{{ section.settings.price }}</div>{% form 'customer', class:'trade-offer__form' %}<input type="hidden" name="contact[tags]" value="trade-offer"><input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required><button class="trade-button trade-button--outline" type="submit">{{ section.settings.subscribe_label }}</button>{% endform %}</div></section>
{% schema %}
{"name":"限时优惠与订阅横幅","tag":"section","class":"section-aiworld-trade-offer","settings":[{"type":"image_picker","id":"image","label":"Desktop image","info":"建议图片尺寸：1920 × 320 px。图片会铺满整个横幅。"},{"type":"image_picker","id":"mobile_image","label":"Mobile image","info":"建议图片尺寸：750 × 560 px。留空时手机端继续使用桌面图片。"},{"type":"text","id":"heading","label":"Heading","default":"Upgrade Your Drive Today"},{"type":"text","id":"text","label":"Text","default":"Join thousands of drivers who choose a smarter, safer connected way to drive."},{"type":"text","id":"price","label":"Price","default":"$199.99"},{"type":"text","id":"button_label","label":"Button label","default":"Buy Now"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"placeholder","label":"Email placeholder","default":"Your email address"},{"type":"text","id":"subscribe_label","label":"Subscribe label","default":"Subscribe"},{"type":"color","id":"background","label":"Background","default":"#07192b"},{"type":"checkbox","id":"enable_top_spacing","label":"Enable top spacing","default":true},{"type":"checkbox","id":"enable_bottom_spacing","label":"Enable bottom spacing","default":true},{"type":"range","id":"padding","min":16,"max":80,"step":4,"unit":"px","label":"Vertical spacing","default":36}],"presets":[{"name":"限时优惠与订阅横幅"}]}
{% endschema %}
