<section class="trade-offer" style="background:{{ section.settings.background }};padding-top:{{ section.settings.padding }}px;padding-bottom:{{ section.settings.padding }}px;"><div class="trade-container trade-offer__inner"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="trade-offer__price">{{ section.settings.price }}</div><a class="trade-button trade-button--blue" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} →</a>{% form 'customer', class:'trade-offer__form' %}<input type="hidden" name="contact[tags]" value="trade-offer"><input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required><button class="trade-button trade-button--blue" type="submit">{{ section.settings.subscribe_label }}</button>{% endform %}</div></section>
{% schema %}
{"name":"AIWORLD trade offer","tag":"section","class":"section-aiworld-trade-offer","settings":[{"type":"text","id":"heading","label":"Heading","default":"Upgrade Your Drive Today"},{"type":"text","id":"text","label":"Text","default":"Join thousands of drivers who choose a smarter, safer connected way to drive."},{"type":"text","id":"price","label":"Price","default":"$199.99"},{"type":"text","id":"button_label","label":"Button label","default":"Buy Now"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"placeholder","label":"Email placeholder","default":"Your email address"},{"type":"text","id":"subscribe_label","label":"Subscribe label","default":"Subscribe"},{"type":"color","id":"background","label":"Background","default":"#07192b"},{"type":"range","id":"padding","min":16,"max":80,"step":4,"unit":"px","label":"Vertical spacing","default":36}],"presets":[{"name":"AIWORLD trade offer"}]}
{% endschema %}
