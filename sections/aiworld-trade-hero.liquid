{%- liquid
  assign hero_width = section.settings.banner_width | default: 1920
  assign hero_height = section.settings.banner_height | default: 720
  assign hero_aspect = hero_width | times: 1.0 | divided_by: hero_height
-%}
<section class="trade-hero trade-hero--{{ section.settings.height_mode | default: 'image' }}" style="--hero-image-aspect:{{ hero_aspect }};--hero-height:{{ section.settings.height }}px;--hero-mobile-height:{{ section.settings.mobile_height }}px;--hero-position:{{ section.settings.image_position }};--hero-image-fit:{{ section.settings.image_fit }};--hero-image-scale:{{ section.settings.image_scale | divided_by: 100.0 }};--overlay:{{ section.settings.overlay | divided_by: 100.0 }};--hero-overlay-color:{{ section.settings.overlay_color }};--hero-overlay-style:{{ section.settings.overlay_style }};--hero-content-justify:{{ section.settings.content_position }};--hero-content-offset:{{ section.settings.content_offset }}%;--hero-text-align:{{ section.settings.text_alignment }};--hero-action-align:{{ section.settings.content_position }};--hero-copy-width:{{ section.settings.copy_width }}px;--hero-text-size:{{ section.settings.text_font_size }}px;--hero-text-color:{{ section.settings.text_color }};--hero-text-line-height:{{ section.settings.text_line_height }};--hero-title-line-gap:{{ section.settings.title_line_gap | default: 0 }}px;--hero-content-y:{{ section.settings.content_vertical }}%;">
  <div class="trade-hero__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width:2400 | image_tag: loading:'eager', widths:'750,1100,1500,2000,2400', sizes:'100vw', alt:section.settings.heading | escape }}{% endif %}</div><div class="trade-hero__overlay trade-hero__overlay--{{ section.settings.overlay_style }}"></div>
  <div class="trade-hero__content"><div class="trade-hero__copy"><div class="trade-hero__eyebrow">{{ section.settings.eyebrow }}</div><h1 class="trade-hero__title">{% assign heading_lines = section.settings.heading | newline_to_br | split: '<br />' %}{% for heading_line in heading_lines %}<span{% if forloop.last and heading_lines.size > 1 %} class="trade-hero__title-accent"{% endif %}>{{ heading_line }}</span>{% unless forloop.last %}<br>{% endunless %}{% endfor %}</h1><div class="trade-hero__text">{{ section.settings.text }}</div>{% if section.settings.show_rating %}<div class="trade-hero__rating">★★★★★ <span>{{ section.settings.rating_text }}</span></div>{% endif %}<div class="trade-hero__price">{{ section.settings.price }}</div><div class="trade-actions">{% if section.settings.button_label != blank %}<a class="trade-button trade-button--blue" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} →</a>{% endif %}{% if section.settings.button_2_label != blank %}<a class="trade-button trade-button--outline" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">{{ section.settings.button_2_label }}</a>{% endif %}</div></div></div>
</section>
{% schema %}
{"name":"首页主视觉横幅","tag":"section","class":"section-aiworld-trade-hero","settings":[{"type":"image_picker","id":"image","label":"Hero image (recommended 1920 × 720 px)","info":"建议图片尺寸：1920 × 720 px"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"AIWORLD Screen X10"},{"type":"textarea","id":"heading","label":"Heading","default":"Smarter Driving\nStarts Here."},{"type":"richtext","id":"text","label":"Text","default":"<p>A 10.26-inch portable wireless CarPlay & Android Auto display for any car. Simple. Powerful. A better way to drive.</p>"},{"type":"range","id":"text_font_size","min":12,"max":32,"step":1,"unit":"px","label":"Text font size","default":18},{"type":"color","id":"text_color","label":"Text color","default":"#FFFFFF"},{"type":"range","id":"text_line_height","min":1,"max":2,"step":0.1,"label":"Text line height","default":1.5},{"type":"text","id":"rating_text","label":"Rating text","default":"4.8 (1,200+ reviews)"},{"type":"checkbox","id":"show_rating","label":"Show rating","default":true},{"type":"text","id":"price","label":"Price","default":"$199.99"},{"type":"text","id":"button_label","label":"Primary button","default":"Buy Now"},{"type":"url","id":"button_link","label":"Primary link"},{"type":"text","id":"button_2_label","label":"Secondary button","default":"Learn More"},{"type":"url","id":"button_2_link","label":"Secondary link"},{"type":"select","id":"content_position","label":"Content horizontal position","options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}],"default":"flex-end"},{"type":"range","id":"content_offset","min":-20,"max":20,"step":1,"unit":"%","label":"Horizontal fine adjustment","default":0},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},{"type":"range","id":"copy_width","min":320,"max":760,"step":20,"unit":"px","label":"Text block width","default":580},{"type":"number","id":"banner_width","label":"Banner width (px)","default":1920},{"type":"number","id":"banner_height","label":"Banner height (px)","default":720},{"type":"range","id":"content_vertical","min":10,"max":90,"step":5,"unit":"%","label":"Vertical position","default":50},{"type":"select","id":"height_mode","label":"Banner height mode","options":[{"value":"image","label":"Auto from image"},{"value":"fixed","label":"Fixed height"}],"default":"image"},{"type":"range","id":"height","min":420,"max":820,"step":20,"unit":"px","label":"Desktop height","default":600},{"type":"range","id":"mobile_height","min":480,"max":820,"step":20,"unit":"px","label":"Mobile height","default":580},{"type":"range","id":"overlay","min":0,"max":100,"step":5,"unit":"%","label":"Overlay strength","default":50},{"type":"color","id":"overlay_color","label":"Overlay color","default":"#020A14"},{"type":"select","id":"overlay_style","label":"Overlay style","options":[{"value":"gradient","label":"Gradient"},{"value":"solid","label":"Solid"},{"value":"none","label":"None"}],"default":"gradient"},{"type":"select","id":"image_fit","label":"Image fit","options":[{"value":"cover","label":"Cover"},{"value":"contain","label":"Contain"}],"default":"cover"},{"type":"range","id":"image_scale","min":100,"max":135,"step":5,"unit":"%","label":"Image scale","default":100},{"type":"select","id":"image_position","label":"Image position","options":[{"value":"left center","label":"Left"},{"value":"center center","label":"Center"},{"value":"right center","label":"Right"}],"default":"center center"}],"presets":[{"name":"首页主视觉横幅"}]}
{% endschema %}
