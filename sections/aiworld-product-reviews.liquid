{{ 'aiworld-product.css' | asset_url | stylesheet_tag }}

<section class="aiworld-product-section aiworld-product-reviews" style="--aiworld-section-bg: {{ section.settings.background_color }}; --aiworld-review-columns: {{ section.settings.columns }};">
  <div class="aiworld-product-section__inner">
    <div class="aiworld-product-section__heading">
      {%- if section.settings.eyebrow != blank -%}<p class="aiworld-product-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="aiworld-product-review-grid">
      {%- for block in section.blocks -%}
        <article class="aiworld-product-review" {{ block.shopify_attributes }}>
          <div class="aiworld-product-review__stars" aria-label="{{ block.settings.rating }} out of 5 stars">★★★★★</div>
          <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
          <div class="aiworld-product-review__author">{{ block.settings.author | escape }}{% if block.settings.verified %} · Verified purchase{% endif %}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "商品评价展示",
  "tag": "section",
  "class": "aiworld-product-reviews-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real drivers. Real reviews." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>See why drivers are upgrading their everyday journeys.</p>" },
    { "type": "select", "id": "columns", "label": "Reviews per row", "options": [
      { "value": "2", "label": "2" },
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ], "default": "3" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f4f8fc" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The setup was simple and the screen is crystal clear. It changed my daily drive." },
        { "type": "text", "id": "author", "label": "Author", "default": "Jason M." },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "商品评价展示",
      "blocks": [
        { "type": "review", "settings": { "quote": "The setup was simple and the screen is crystal clear. It changed my daily drive.", "author": "Jason M." } },
        { "type": "review", "settings": { "quote": "Exactly what I needed for my older car. It looks clean and works flawlessly.", "author": "Sarah L." } },
        { "type": "review", "settings": { "quote": "The screen is big, responsive, and makes daily commutes much more enjoyable.", "author": "Michael T." } }
      ]
    }
  ]
}
{% endschema %}
