<footer class="aiworld-trade-footer" style="--trade-footer-bg:{{ section.settings.background }};--trade-footer-fg:{{ section.settings.text_color }};--trade-footer-accent:{{ section.settings.accent_color }};"><div class="trade-container aiworld-trade-footer__grid"><div class="aiworld-trade-footer__brand">{% if section.settings.brand_logo != blank %}{{ section.settings.brand_logo | image_url: width:720 | image_tag: class:'aiworld-trade-footer__logo-image', loading:'lazy', widths:'180,360,540,720', sizes:'190px', alt:section.settings.brand_name | escape }}{% else %}<div class="aiworld-trade-footer__logo">{{ section.settings.brand_name }}</div>{% endif %}<p>{{ section.settings.brand_text }}</p>{% if section.settings.contact_heading != blank or section.settings.contact_email != blank or section.settings.contact_phone != blank or section.settings.contact_hours != blank %}<div class="aiworld-trade-footer__contact"><h2>{{ section.settings.contact_heading }}</h2>{% if section.settings.contact_email != blank %}<a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email }}</a>{% endif %}{% if section.settings.contact_phone != blank %}<a href="tel:{{ section.settings.contact_phone | remove:' ' | remove:'(' | remove:')' | remove:'-' }}">{{ section.settings.contact_phone }}</a>{% endif %}{% if section.settings.contact_hours != blank %}<p>{{ section.settings.contact_hours | newline_to_br }}</p>{% endif %}</div>{% endif %}{% if section.settings.show_social %}<div class="aiworld-trade-footer__social">{% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}">◎</a>{% endif %}{% if section.settings.youtube_url != blank %}<a href="{{ section.settings.youtube_url }}">▶</a>{% endif %}{% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}">f</a>{% endif %}</div>{% endif %}</div>{% for block in section.blocks %}<div class="aiworld-trade-footer__column" {{ block.shopify_attributes }}><h2>{{ block.settings.heading }}</h2>{% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}<ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>{% else %}<ul>{% assign links = block.settings.fallback_links | newline_to_br | split:'<br />' %}{% for label in links %}{% assign clean = label | strip %}{% if clean != blank %}<li><a href="{{ routes.root_url }}">{{ clean }}</a></li>{% endif %}{% endfor %}</ul>{% endif %}</div>{% endfor %}{% if section.settings.news_image != blank %}<div class="aiworld-trade-footer__news"><h2>{{ section.settings.news_heading }}</h2><a href="{{ section.settings.news_link | default: routes.blogs_url }}">{{ section.settings.news_image | image_url: width:720 | image_tag: loading:'lazy', widths:'360,540,720', sizes:'320px', alt:section.settings.news_heading | escape }}<span>{{ section.settings.news_text }}</span></a></div>{% endif %}</div><div class="aiworld-trade-footer__bottom"><div class="trade-container"><span>© {{ 'now' | date:'%Y' }} {{ section.settings.brand_name }}. All rights reserved.</span><span>{{ section.settings.bottom_text }}</span></div></div></footer>
{% schema %}
{"name":"网站页脚与联系信息","tag":"section","class":"section-aiworld-trade-footer","settings":[{"type":"text","id":"brand_name","label":"Brand name","default":"AIWORLD"},{"type":"image_picker","id":"brand_logo","label":"Footer logo PNG (recommended 360 × 70 px)","info":"建议上传透明 PNG，尺寸：360 × 70 px"},{"type":"textarea","id":"brand_text","label":"Brand text","default":"Smart Technology for Everyday Life."},{"type":"text","id":"contact_heading","label":"Contact heading","default":"CONTACT US"},{"type":"text","id":"contact_email","label":"Contact email","default":"support@mergescreens.com"},{"type":"text","id":"contact_phone","label":"Contact phone","default":"+1 (302) 303-5099"},{"type":"textarea","id":"contact_hours","label":"Contact hours","default":"Mon-Sat: 10:00am - 6:00pm\nCT"},{"type":"checkbox","id":"show_social","label":"Show social links","default":true},{"type":"url","id":"instagram_url","label":"Instagram link"},{"type":"url","id":"youtube_url","label":"YouTube link"},{"type":"url","id":"facebook_url","label":"Facebook link"},{"type":"image_picker","id":"news_image","label":"Latest news image (recommended 800 × 516 px)","info":"建议图片尺寸：800 × 516 px"},{"type":"text","id":"news_heading","label":"News heading","default":"Latest News"},{"type":"text","id":"news_text","label":"News text","default":"Discover smarter product insights"},{"type":"url","id":"news_link","label":"News link"},{"type":"text","id":"bottom_text","label":"Bottom text","default":"A Smarter Way to Drive."},{"type":"color","id":"background","label":"Background","default":"#06182c"},{"type":"color","id":"text_color","label":"Text color","default":"#ffffff"},{"type":"color","id":"accent_color","label":"Accent color","default":"#14a5ff"}],"blocks":[{"type":"link_column","name":"Link column","settings":[{"type":"text","id":"heading","label":"Heading","default":"Product"},{"type":"link_list","id":"menu","label":"Menu"},{"type":"textarea","id":"fallback_links","label":"Fallback links, one per line","default":"AIWORLD Screen X10\nFeatures\nReviews"}]}],"max_blocks":6,"presets":[{"name":"网站页脚与联系信息"}]}
{% endschema %}
