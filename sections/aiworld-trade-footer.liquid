<footer class="aiworld-trade-footer" style="--trade-footer-bg:{{ section.settings.background }};--trade-footer-fg:{{ section.settings.text_color }};--trade-footer-accent:{{ section.settings.accent_color }};"><div class="trade-container aiworld-trade-footer__grid"><div class="aiworld-trade-footer__brand">{% if section.settings.brand_logo != blank %}{{ section.settings.brand_logo | image_url: width:720 | image_tag: class:'aiworld-trade-footer__logo-image', loading:'lazy', widths:'180,360,540,720', sizes:'190px', alt:section.settings.brand_name | escape }}{% else %}<div class="aiworld-trade-footer__logo">{{ section.settings.brand_name }}</div>{% endif %}<p>{{ section.settings.brand_text }}</p>{% if section.settings.contact_heading != blank or section.settings.contact_email != blank or section.settings.contact_phone != blank or section.settings.contact_hours != blank %}<div class="aiworld-trade-footer__contact"><h2>{{ section.settings.contact_heading }}</h2>{% if section.settings.contact_email != blank %}<a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email }}</a>{% endif %}{% if section.settings.contact_phone != blank %}<a href="tel:{{ section.settings.contact_phone | remove:' ' | remove:'(' | remove:')' | remove:'-' }}">{{ section.settings.contact_phone }}</a>{% endif %}{% if section.settings.contact_hours != blank %}<p>{{ section.settings.contact_hours | newline_to_br }}</p>{% endif %}</div>{% endif %}{% if section.settings.show_social %}<div class="aiworld-trade-footer__social">{% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>{% endif %}{% if section.settings.youtube_url != blank %}<a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">YouTube</a>{% endif %}{% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">Facebook</a>{% endif %}</div>{% endif %}</div>{% for block in section.blocks %}<div class="aiworld-trade-footer__column" {{ block.shopify_attributes }}><h2>{{ block.settings.heading }}</h2>{% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}<ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>{% else %}<ul>{% assign links = block.settings.fallback_links | newline_to_br | split:'<br />' %}{% for label in links %}{% assign clean = label | strip %}{% if clean != blank %}{% assign link_url = routes.root_url %}{% assign external_link = false %}{% if clean == 'AIWORLD Screen X10' %}{% assign link_url = routes.root_url | append:'products/9-inch-wireless-carplay' %}{% elsif clean == 'Features' %}{% assign link_url = routes.root_url | append:'#features' %}{% elsif clean == 'Reviews' %}{% assign link_url = routes.root_url | append:'#reviews' %}{% elsif clean == 'Help Center' %}{% assign link_url = routes.root_url | append:'pages/support-center' %}{% elsif clean == 'Contact Us' %}{% assign link_url = routes.root_url | append:'pages/contact' %}{% elsif clean == 'Installation Guide' %}{% assign link_url = routes.root_url | append:'pages/installation-guide' %}{% elsif clean == 'Shipping Policy' and shop.shipping_policy != blank %}{% assign link_url = shop.shipping_policy.url %}{% elsif clean == 'Returns & Refunds' and shop.refund_policy != blank %}{% assign link_url = shop.refund_policy.url %}{% elsif clean == 'Privacy Policy' and shop.privacy_policy != blank %}{% assign link_url = shop.privacy_policy.url %}{% elsif clean == 'Terms of Service' and shop.terms_of_service != blank %}{% assign link_url = shop.terms_of_service.url %}{% elsif clean == 'Instagram' %}{% assign link_url = section.settings.instagram_url | default:'https://www.instagram.com/' %}{% assign external_link = true %}{% elsif clean == 'YouTube' %}{% assign link_url = section.settings.youtube_url | default:'https://www.youtube.com/' %}{% assign external_link = true %}{% elsif clean == 'Facebook' %}{% assign link_url = section.settings.facebook_url | default:'https://www.facebook.com/' %}{% assign external_link = true %}{% endif %}<li><a href="{{ link_url }}"{% if external_link %} target="_blank" rel="noopener"{% endif %}>{{ clean }}</a></li>{% endif %}{% endfor %}</ul>{% endif %}</div>{% endfor %}{% if section.settings.news_image != blank %}<div class="aiworld-trade-footer__news"><h2>{{ section.settings.news_heading }}</h2><a href="{{ section.settings.news_link | default: routes.blogs_url }}">{{ section.settings.news_image | image_url: width:720 | image_tag: loading:'lazy', widths:'360,540,720', sizes:'320px', alt:section.settings.news_heading | escape }}<span>{{ section.settings.news_text }}</span></a></div>{% endif %}</div><div class="aiworld-trade-footer__bottom"><div class="trade-container"><span>© {{ 'now' | date:'%Y' }} {{ section.settings.brand_name }}. All rights reserved.</span><span>{{ section.settings.bottom_text }}</span></div></div></footer>
{% schema %}
{"name":"Footer and contact","tag":"section","class":"section-aiworld-trade-footer","settings":[{"type":"text","id":"brand_name","label":"Brand name","default":"AIWORLD"},{"type":"image_picker","id":"brand_logo","label":"Footer logo PNG (recommended 360 x 70 px)","info":"Upload a transparent PNG, recommended size: 360 x 70 px"},{"type":"textarea","id":"brand_text","label":"Brand text","default":"Smart Technology for Everyday Life."},{"type":"text","id":"contact_heading","label":"Contact heading","default":"CONTACT US"},{"type":"text","id":"contact_email","label":"Contact email","default":"support@aiworldlife.com"},{"type":"text","id":"contact_phone","label":"Contact phone","default":"+1 (302) 303-5099"},{"type":"textarea","id":"contact_hours","label":"Contact hours","default":"Mon-Sat: 10:00am - 6:00pm\nCT"},{"type":"checkbox","id":"show_social","label":"Show social links","default":true},{"type":"url","id":"instagram_url","label":"Instagram link"},{"type":"url","id":"youtube_url","label":"YouTube link"},{"type":"url","id":"facebook_url","label":"Facebook link"},{"type":"image_picker","id":"news_image","label":"Latest news image (recommended 800 x 516 px)","info":"Recommended image size: 800 x 516 px"},{"type":"text","id":"news_heading","label":"News heading","default":"Latest News"},{"type":"text","id":"news_text","label":"News text","default":"Discover smarter product insights"},{"type":"url","id":"news_link","label":"News link"},{"type":"text","id":"bottom_text","label":"Bottom text","default":"A Smarter Way to Drive."},{"type":"color","id":"background","label":"Background","default":"#06182c"},{"type":"color","id":"text_color","label":"Text color","default":"#ffffff"},{"type":"color","id":"accent_color","label":"Accent color","default":"#14a5ff"}],"blocks":[{"type":"link_column","name":"Link column","settings":[{"type":"text","id":"heading","label":"Heading","default":"Product"},{"type":"link_list","id":"menu","label":"Menu"},{"type":"textarea","id":"fallback_links","label":"Fallback links, one per line","default":"AIWORLD Screen X10\nFeatures\nReviews"}]}],"max_blocks":6,"presets":[{"name":"Footer and contact"}]}
{% endschema %}
