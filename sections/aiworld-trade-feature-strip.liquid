<section class="trade-feature-strip" style="background:{{ section.settings.background }};"><div class="trade-container trade-feature-strip__grid">{% for block in section.blocks %}<div class="trade-feature-strip__item" style="--feature-icon-size:{{ block.settings.icon_size | default: 67 }}px;" {{ block.shopify_attributes }}><span class="trade-feature-strip__icon">{% if block.settings.icon_image != blank %}<img class="trade-feature-strip__icon-image" src="{{ block.settings.icon_image | image_url: width: 160 }}" alt="{{ block.settings.title | escape }}" width="160" height="160" loading="lazy">{% else %}{{ block.settings.icon }}{% endif %}</span><div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div></div>{% endfor %}</div></section>
{% schema %}
{"name":"AIWORLD feature strip","tag":"section","class":"section-aiworld-trade-feature-strip","settings":[{"type":"color","id":"background","label":"Background","default":"#ffffff"}],"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"image_picker","id":"icon_image","label":"Icon image (1:1, recommended 120 × 120 px)","info":"建议使用 1:1 图片，尺寸：120 × 120 px"},{"type":"range","id":"icon_size","label":"Icon size (px)","min":24,"max":120,"step":1,"unit":"px","default":67},{"type":"text","id":"icon","label":"Fallback icon","default":"O"},{"type":"text","id":"title","label":"Title","default":"Wireless CarPlay"},{"type":"text","id":"text","label":"Text","default":"No cords. Just drive."}]}],"max_blocks":4,"presets":[{"name":"AIWORLD feature strip","blocks":[{"type":"feature","settings":{"icon":"O","icon_size":67,"title":"Wireless CarPlay","text":"No cords. Just drive."}},{"type":"feature","settings":{"icon":"A","icon_size":67,"title":"Android Auto","text":"Wirelessly wired."}},{"type":"feature","settings":{"icon":"G","icon_size":67,"title":"Plug and Play","text":"Install in minutes."}},{"type":"feature","settings":{"icon":"C","icon_size":67,"title":"Fits Most Vehicles","text":"Cars, trucks, SUVs & more."}}]}]}
{% endschema %}
