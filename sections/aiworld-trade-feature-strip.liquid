<section class="trade-feature-strip{% if section.settings.enable_top_spacing == false %} trade-section--no-top-spacing{% endif %}{% if section.settings.enable_bottom_spacing == false %} trade-section--no-bottom-spacing{% endif %}" style="background:{{ section.settings.background }};"><div class="trade-container trade-feature-strip__grid">{% for block in section.blocks %}<div class="trade-feature-strip__item" style="--feature-icon-size:{{ block.settings.icon_size | default: 67 }}px;" {{ block.shopify_attributes }}><span class="trade-feature-strip__icon">{% if block.settings.icon_image != blank %}<img class="trade-feature-strip__icon-image" src="{{ block.settings.icon_image | image_url: width: 160 }}" alt="{{ block.settings.title | escape }}" width="160" height="160" loading="lazy">{% elsif block.settings.icon != blank %}{{ block.settings.icon }}{% else %}{% case forloop.index %}{% when 1 %}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="7" y="3" width="10" height="18" rx="2"></rect><path d="M10 18h4"></path></svg>{% when 2 %}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 16v-4l2-4h10l2 4v4"></path><path d="M5 12h14"></path><circle cx="8" cy="16" r="1"></circle><circle cx="16" cy="16" r="1"></circle></svg>{% when 3 %}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="12" rx="1"></rect><path d="M9 21h6M12 17v4"></path></svg>{% when 4 %}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 3v5M16 3v5M6 8h12v2a6 6 0 0 1-6 6v5"></path></svg>{% endcase %}{% endif %}</span><div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div></div>{% endfor %}</div></section>
{% schema %}
{"name":"AIWORLD feature strip","tag":"section","class":"section-aiworld-trade-feature-strip","settings":[{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"checkbox","id":"enable_top_spacing","label":"Enable top spacing","default":true},{"type":"checkbox","id":"enable_bottom_spacing","label":"Enable bottom spacing","default":true}],"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"image_picker","id":"icon_image","label":"Icon image (1:1, recommended 120 × 120 px)","info":"建议使用 1:1 图片，尺寸：120 × 120 px"},{"type":"range","id":"icon_size","label":"Icon size (px)","min":24,"max":120,"step":1,"unit":"px","default":67},{"type":"text","id":"icon","label":"Fallback icon","default":"O"},{"type":"text","id":"title","label":"Title","default":"Wireless CarPlay"},{"type":"text","id":"text","label":"Text","default":"No cords. Just drive."}]}],"max_blocks":4,"presets":[{"name":"AIWORLD feature strip","blocks":[{"type":"feature","settings":{"icon":"O","icon_size":67,"title":"Wireless CarPlay","text":"No cords. Just drive."}},{"type":"feature","settings":{"icon":"A","icon_size":67,"title":"Android Auto","text":"Wirelessly wired."}},{"type":"feature","settings":{"icon":"G","icon_size":67,"title":"Plug and Play","text":"Install in minutes."}},{"type":"feature","settings":{"icon":"C","icon_size":67,"title":"Fits Most Vehicles","text":"Cars, trucks, SUVs & more."}}]}]}
{% endschema %}
