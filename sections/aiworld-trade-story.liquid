<section class="trade-story" style="min-height:{{ section.settings.height }}px;"><div class="trade-story__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width:2200 | image_tag: loading:'lazy', widths:'750,1100,1500,2000,2200', sizes:'100vw', alt:section.settings.heading | escape }}{% endif %}</div><div class="trade-story__shade"></div><div class="trade-container trade-story__content"><div class="trade-story__copy"><p class="trade-kicker">{{ section.settings.kicker }}</p><h2>{{ section.settings.heading | newline_to_br }}</h2><div>{{ section.settings.text }}</div><div class="trade-story__points">{% for block in section.blocks %}<div class="trade-story__point" style="--story-icon-size:{{ block.settings.icon_size | default: 36 }}px;" {{ block.shopify_attributes }}>{% if block.settings.icon_image != blank %}{{ block.settings.icon_image | image_url: width:120 | image_tag: class:'trade-story__point-icon', loading:'lazy', widths:'60,90,120', sizes:'var(--story-icon-size)', alt:block.settings.title | escape }}{% endif %}<strong>{{ block.settings.title }}</strong><div>{{ block.settings.text }}</div></div>{% endfor %}</div></div></div></section>
{% schema %}
{"name":"AIWORLD story banner","tag":"section","class":"section-aiworld-trade-story","settings":[{"type":"image_picker","id":"image","label":"Background image (recommended 1920 × 720 px)","info":"建议图片尺寸：1920 × 720 px"},{"type":"text","id":"kicker","label":"Kicker","default":"DRIVE SMARTER EVERY DAY"},{"type":"text","id":"heading","label":"Heading","default":"More Than a Screen.\nA Better Driving Experience."},{"type":"richtext","id":"text","label":"Text","default":"<p>AIWORLD Screen X10 keeps you connected, informed, and in control - so you can focus on what matters most: the road ahead.</p>"},{"type":"range","id":"height","min":360,"max":720,"step":20,"unit":"px","label":"Height","default":480},{"type":"select","id":"image_position","label":"Image position","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"}],"blocks":[{"type":"point","name":"Benefit","settings":[{"type":"image_picker","id":"icon_image","label":"Icon image (PNG, 1:1, recommended 96 × 96 px)","info":"建议使用透明 PNG，尺寸：96 × 96 px"},{"type":"range","id":"icon_size","label":"Icon size","min":20,"max":64,"step":1,"unit":"px","default":36},{"type":"text","id":"title","label":"Title","default":"Navigation Made Easy"},{"type":"text","id":"text","label":"Text","default":"Get real-time directions on a larger, clearer screen."}]}],"max_blocks":4,"presets":[{"name":"AIWORLD story banner","blocks":[{"type":"point","settings":{"title":"Navigation Made Easy","text":"Get real-time directions on a larger, clearer screen."}},{"type":"point","settings":{"title":"Your Music, Your Way","text":"Stream your favorite apps wirelessly while you drive."}},{"type":"point","settings":{"title":"A Safer, More Connected Drive","text":"Hands-free control keeps you focused and safer on the road."}}]}]}
{% endschema %}
