<section class="trade-reviews" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background:{{ section.settings.background }};"><div class="trade-container"><div class="trade-head"><p class="trade-kicker">{{ section.settings.kicker }}</p><h2 class="trade-heading">{{ section.settings.heading }}</h2><p class="trade-subheading">{{ section.settings.subheading }}</p></div><div class="trade-review-grid">{% for block in section.blocks %}<article class="trade-review" {{ block.shopify_attributes }}><div class="trade-review__stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</div><blockquote>“{{ block.settings.quote }}”</blockquote><div class="trade-review__author">— {{ block.settings.author }}{% if block.settings.verified %} · ✓ Verified Purchase{% endif %}</div></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"AIWORLD trade reviews","tag":"section","class":"section-aiworld-trade-reviews","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"REAL DRIVERS. REAL REVIEWS."},{"type":"text","id":"heading","label":"Heading","default":"Loved by Thousands"},{"type":"text","id":"subheading","label":"Subheading","default":"4.8 out of 5 (1,200+ verified reviews)"},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"range","id":"padding_top","min":0,"max":120,"step":4,"unit":"px","label":"Top spacing","default":48},{"type":"range","id":"padding_bottom","min":0,"max":120,"step":4,"unit":"px","label":"Bottom spacing","default":48}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","min":1,"max":5,"step":1,"label":"Rating","default":5},{"type":"textarea","id":"quote","label":"Quote","default":"Super easy to set up and works perfectly in my car. The screen is crystal clear and wireless CarPlay is a game changer!"},{"type":"text","id":"author","label":"Author","default":"Jason M."},{"type":"checkbox","id":"verified","label":"Verified purchase","default":true}]}],"max_blocks":6,"presets":[{"name":"AIWORLD trade reviews","blocks":[{"type":"review","settings":{"quote":"Super easy to set up and works perfectly in my car. The screen is crystal clear and wireless CarPlay is a game changer!","author":"Jason M."}},{"type":"review","settings":{"quote":"Exactly what I needed for my older car. Took 5 minutes to install and it works flawlessly.","author":"Sarah L."}},{"type":"review","settings":{"quote":"Love this thing! The screen is big, the touch response is smooth, and it makes my daily commute so much better.","author":"Michael T."}}]}]}
{% endschema %}
