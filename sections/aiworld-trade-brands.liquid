<section class="trade-brands" style="background:{{ section.settings.background }};padding-top:{{ section.settings.padding }}px;padding-bottom:{{ section.settings.padding }}px;"><div class="trade-container trade-brands__row"><span>{{ section.settings.label }}</span>{% for block in section.blocks %}<div class="trade-brands__logo" style="color:{{ block.settings.color }};" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width:300 | image_tag: loading:'lazy', widths:'150,240,300', sizes:'18vw', alt:block.settings.name | escape }}{% else %}{{ block.settings.name }}{% endif %}</div>{% endfor %}</div></section>
{% schema %}
{"name":"AIWORLD trade featured in","tag":"section","class":"section-aiworld-trade-brands","settings":[{"type":"text","id":"label","label":"Label","default":"FEATURED IN"},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"range","id":"padding","min":8,"max":60,"step":4,"unit":"px","label":"Vertical spacing","default":24}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"image_picker","id":"image","label":"Logo image (recommended 300 × 100 px)","info":"建议使用透明 PNG，尺寸：300 × 100 px"},{"type":"text","id":"name","label":"Name","default":"TechDrive"},{"type":"color","id":"color","label":"Text color","default":"#24374d"}]}],"max_blocks":8,"presets":[{"name":"AIWORLD trade featured in","blocks":[{"type":"brand","settings":{"name":"TechDrive"}},{"type":"brand","settings":{"name":"AutoGear"}},{"type":"brand","settings":{"name":"Modern Mobility"}},{"type":"brand","settings":{"name":"CAR TECH TODAY"}},{"type":"brand","settings":{"name":"The Drive Life"}}]}]}
{% endschema %}
