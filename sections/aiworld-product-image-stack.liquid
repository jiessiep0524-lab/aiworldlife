{%- if section.blocks.size > 0 -%}
  <section
    class="aiworld-product-section aiworld-product-image-stack"
    style="--aiworld-image-stack-bg: {{ section.settings.background_color }}; --aiworld-image-stack-width: {{ section.settings.max_width }}px; --aiworld-image-stack-gap: {{ section.settings.gap }}px; --aiworld-image-stack-radius: {{ section.settings.image_radius }}px; --aiworld-image-stack-top: {{ section.settings.padding_top }}px; --aiworld-image-stack-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="aiworld-product-image-stack__inner">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank or block.settings.mobile_image != blank -%}
          {%- assign desktop_image = block.settings.image -%}
          {%- if desktop_image == blank -%}
            {%- assign desktop_image = block.settings.mobile_image -%}
          {%- endif -%}
          {%- assign image_alt = block.settings.alt_text | default: product.title -%}
          <div class="aiworld-product-image-stack__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
              <picture>
                {%- if block.settings.mobile_image != blank -%}
                  <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}">
                {%- endif -%}
                {{ desktop_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1000, 1400, 1800, 2200', sizes: 'calc(100vw - 2rem)', alt: image_alt }}
              </picture>
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Amazon image details",
  "tag": "section",
  "class": "aiworld-product-image-stack-section",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Maximum image width", "min": 800, "max": 1800, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "gap", "label": "Space between images", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
        { "type": "text", "id": "alt_text", "label": "Image alt text", "info": "Describe the image for accessibility and search engines. If blank, the product title is used." },
        { "type": "url", "id": "link", "label": "Optional image link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Amazon image details",
      "blocks": [
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
