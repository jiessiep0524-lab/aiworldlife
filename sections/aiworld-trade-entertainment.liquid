<section id="Entertainment-{{ section.id }}" class="trade-entertainment" data-entertainment-section style="--entertainment-background:{{ section.settings.background }};--entertainment-accent:{{ section.settings.accent_color }};--entertainment-ink:{{ section.settings.text_color }};--entertainment-padding-top:{% if section.settings.enable_top_spacing == false %}0{% else %}{{ section.settings.padding_top }}{% endif %}px;--entertainment-padding-bottom:{% if section.settings.enable_bottom_spacing == false %}0{% else %}{{ section.settings.padding_bottom }}{% endif %}px;--entertainment-mobile-padding-top:{% if section.settings.enable_top_spacing == false %}0{% else %}{{ section.settings.mobile_padding_top | default: 40 }}{% endif %}px;--entertainment-mobile-padding-bottom:{% if section.settings.enable_bottom_spacing == false %}0{% else %}{{ section.settings.mobile_padding_bottom | default: 40 }}{% endif %}px;">
  <div class="trade-container">
    <div class="trade-entertainment__head">
      <p class="trade-kicker">{{ section.settings.kicker | escape }}</p>
      <h2 class="trade-heading">{{ section.settings.heading | escape }}</h2>
      <p class="trade-subheading">{{ section.settings.subheading | escape }}</p>
    </div>

    <div class="trade-entertainment__tabs" role="tablist" aria-label="{{ section.settings.tabs_label | escape }}">
      {% for block in section.blocks %}
        <button id="EntertainmentTab-{{ section.id }}-{{ block.id }}" class="trade-entertainment__tab{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-controls="EntertainmentPanel-{{ section.id }}-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-entertainment-tab="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.tab_label | escape }}</button>
      {% endfor %}
    </div>

    <div class="trade-entertainment__panels">
      {% for block in section.blocks %}
        <div id="EntertainmentPanel-{{ section.id }}-{{ block.id }}" class="trade-entertainment__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel" aria-labelledby="EntertainmentTab-{{ section.id }}-{{ block.id }}" data-entertainment-panel="{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
          <div class="trade-entertainment__cards" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.carousel_label | escape }}: {{ block.settings.tab_label | escape }}" data-entertainment-track tabindex="0">
            <article id="EntertainmentCard-{{ section.id }}-{{ block.id }}-1" class="trade-entertainment__card" data-entertainment-card role="group" aria-roledescription="slide" aria-label="{{ section.settings.slide_label | escape }} 1 of 3">
              {% if block.settings.image_1 != blank %}
                {{ block.settings.image_1 | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,800,1200,1600', sizes: '(min-width: 990px) 33vw, 88vw', alt: block.settings.title_1 | escape }}
              {% else %}
                <div class="trade-entertainment__placeholder" aria-hidden="true"></div>
              {% endif %}
              <div class="trade-entertainment__card-copy">
                <h3>{{ block.settings.title_1 | escape }}</h3>
                <p>{{ block.settings.text_1 | escape }}</p>
              </div>
            </article>
            <article id="EntertainmentCard-{{ section.id }}-{{ block.id }}-2" class="trade-entertainment__card" data-entertainment-card role="group" aria-roledescription="slide" aria-label="{{ section.settings.slide_label | escape }} 2 of 3">
              {% if block.settings.image_2 != blank %}
                {{ block.settings.image_2 | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,800,1200,1600', sizes: '(min-width: 990px) 33vw, 88vw', alt: block.settings.title_2 | escape }}
              {% else %}
                <div class="trade-entertainment__placeholder" aria-hidden="true"></div>
              {% endif %}
              <div class="trade-entertainment__card-copy">
                <h3>{{ block.settings.title_2 | escape }}</h3>
                <p>{{ block.settings.text_2 | escape }}</p>
              </div>
            </article>
            <article id="EntertainmentCard-{{ section.id }}-{{ block.id }}-3" class="trade-entertainment__card" data-entertainment-card role="group" aria-roledescription="slide" aria-label="{{ section.settings.slide_label | escape }} 3 of 3">
              {% if block.settings.image_3 != blank %}
                {{ block.settings.image_3 | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,800,1200,1600', sizes: '(min-width: 990px) 33vw, 88vw', alt: block.settings.title_3 | escape }}
              {% else %}
                <div class="trade-entertainment__placeholder" aria-hidden="true"></div>
              {% endif %}
              <div class="trade-entertainment__card-copy">
                <h3>{{ block.settings.title_3 | escape }}</h3>
                <p>{{ block.settings.text_3 | escape }}</p>
              </div>
            </article>
          </div>
          <div class="trade-entertainment__progress" role="group" aria-label="{{ section.settings.progress_label | escape }}" data-entertainment-progress>
            {% for i in (1..3) %}
              <button type="button" class="trade-entertainment__progress-dot{% if forloop.first %} is-active{% endif %}" data-entertainment-progress-dot="{{ forloop.index0 }}" aria-label="{{ section.settings.slide_label | escape }} {{ forloop.index }} of 3" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('#Entertainment-{{ section.id }}');
    if (!root || root.dataset.entertainmentReady === 'true') return;
    root.dataset.entertainmentReady = 'true';
    const tabs = [...root.querySelectorAll('[data-entertainment-tab]')];
    const panels = [...root.querySelectorAll('[data-entertainment-panel]')];
    const tracks = new Map();

    const setTrackState = (track, index) => {
      track.querySelectorAll('[data-entertainment-progress-dot]').forEach((dot, dotIndex) => {
        const active = dotIndex === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-current', active ? 'true' : 'false');
      });
    };

    const getClosestCard = (track, cards) => {
      const left = track.scrollLeft;
      return cards.reduce((closest, card, index) => {
        const distance = Math.abs(card.offsetLeft - left);
        return distance < closest.distance ? { index, distance } : closest;
      }, { index: 0, distance: Infinity }).index;
    };

    const initTrack = (panel) => {
      const track = panel.querySelector('[data-entertainment-track]');
      const cards = [...panel.querySelectorAll('[data-entertainment-card]')];
      if (!track || !cards.length) return;
      const goTo = (requestedIndex, behavior = 'smooth') => {
        const index = Math.max(0, Math.min(requestedIndex, cards.length - 1));
        track.scrollTo({ left: cards[index].offsetLeft, behavior });
        setTrackState(track, index);
      };
      const sync = () => setTrackState(track, getClosestCard(track, cards));
      const dots = [...panel.querySelectorAll('[data-entertainment-progress-dot]')];
      dots.forEach((dot) => dot.addEventListener('click', () => goTo(parseInt(dot.dataset.entertainmentProgressDot, 10))));
      track.addEventListener('keydown', (event) => {
        const current = getClosestCard(track, cards);
        if (event.key === 'ArrowRight') { event.preventDefault(); goTo(current + 1); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(current - 1); }
        if (event.key === 'Home') { event.preventDefault(); goTo(0); }
        if (event.key === 'End') { event.preventDefault(); goTo(cards.length - 1); }
      });
      track.addEventListener('scroll', sync, { passive: true });
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) setTrackState(track, cards.indexOf(visible.target));
        }, { root: track, threshold: [0.6] });
        cards.forEach((card) => observer.observe(card));
      }
      setTrackState(track, 0);
      tracks.set(panel, { reset: () => goTo(0, 'auto') });
    };

    panels.forEach(initTrack);

    const activate = (id, moveFocus) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.entertainmentTab === id;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        if (active && moveFocus) tab.focus();
      });
      panels.forEach((panel) => {
        const active = panel.dataset.entertainmentPanel === id;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
        if (active) tracks.get(panel)?.reset();
      });
    };
    tabs.forEach((tab, tabIndex) => {
      tab.addEventListener('click', () => activate(tab.dataset.entertainmentTab, false));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (tabIndex + (event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
        activate(tabs[nextIndex].dataset.entertainmentTab, true);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "车载娱乐功能展示",
  "tag": "section",
  "class": "section-aiworld-trade-entertainment",
  "settings": [
    { "type": "header", "content": "图片设置：展开下方内容标签模块编辑卡片图片（推荐 1200 × 1540 px）" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "AIWORLD SCREEN" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Entertainment Wherever You Go" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Make your dashboard feel like a tablet. Movies, games and apps all at your fingertips." },
    { "type": "text", "id": "tabs_label", "label": "Tabs accessibility label", "default": "Entertainment features" },
    { "type": "text", "id": "carousel_label", "label": "Carousel accessibility label", "default": "Entertainment showcase" },
    { "type": "text", "id": "progress_label", "label": "Progress accessibility label", "default": "Entertainment card navigation" },
    { "type": "text", "id": "slide_label", "label": "Slide accessibility label", "default": "Card" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f5f8fb" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#0787f9" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#06182a" },
    { "type": "checkbox", "id": "enable_top_spacing", "label": "Enable top spacing", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top spacing", "default": 72 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "移动端上方间距", "default": 40 },
    { "type": "checkbox", "id": "enable_bottom_spacing", "label": "Enable bottom spacing", "default": true },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 72 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "移动端下方间距", "default": 40 }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "内容标签（含 3 张卡片）",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "CONNECTED DRIVING" },
        { "type": "image_picker", "id": "image_1", "label": "卡片 1 图片（点击上传/更换）", "info": "推荐尺寸：1200 × 1540 px；竖版约 0.78:1，卡片会裁切填充" },
        { "type": "text", "id": "title_1", "label": "Card 1 title", "default": "Wireless CarPlay & Android Auto" },
        { "type": "textarea", "id": "text_1", "label": "Card 1 text", "default": "Connect wirelessly and access navigation, music, messages, and calls on a larger screen." },
        { "type": "image_picker", "id": "image_2", "label": "卡片 2 图片（点击上传/更换）", "info": "推荐尺寸：1200 × 1540 px；竖版约 0.78:1，卡片会裁切填充" },
        { "type": "text", "id": "title_2", "label": "Card 2 title", "default": "Navigation at a Glance" },
        { "type": "textarea", "id": "text_2", "label": "Card 2 text", "default": "Get clear turn-by-turn directions on a bright 9-inch display." },
        { "type": "image_picker", "id": "image_3", "label": "卡片 3 图片（点击上传/更换）", "info": "推荐尺寸：1200 × 1540 px；竖版约 0.78:1，卡片会裁切填充" },
        { "type": "text", "id": "title_3", "label": "Card 3 title", "default": "Hands-Free Control" },
        { "type": "textarea", "id": "text_3", "label": "Card 3 text", "default": "Make calls, send messages, and stay connected without reaching for your phone." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "车载娱乐功能展示",
      "blocks": [
        { "type": "panel", "settings": { "tab_label": "CONNECTED DRIVING" } },
        { "type": "panel", "settings": { "tab_label": "SMARTER CAR EXPERIENCE" } },
        { "type": "panel", "settings": { "tab_label": "EVERYDAY CONVENIENCE" } }
      ]
    }
  ]
}
{% endschema %}
