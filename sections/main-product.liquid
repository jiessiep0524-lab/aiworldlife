<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
    <div class="page-width">
      <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
        <div class="grid__item product__media-wrapper">
          {% render 'product-media-gallery', variant_images: variant_images %}
        </div>
        <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <section
            id="ProductInfo-{{ section.id }}"
            class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
          >
            {%- assign product_form_id = 'product-form-' | append: section.id -%}
            {%- assign cd_mount_product = blank -%}
            {%- assign camera_product = blank -%}
            {%- assign protection_product = blank -%}
            {%- assign has_addon_picker = false -%}
            {%- for bundle_block in section.blocks -%}
              {%- if bundle_block.type == 'aiworld_cd_mount_picker' -%}
                {%- assign has_addon_picker = true -%}
                {%- assign cd_mount_product = bundle_block.settings.cd_mount_product -%}
                {%- assign camera_product = bundle_block.settings.camera_product -%}
                {%- assign protection_product = bundle_block.settings.protection_product -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if has_addon_picker -%}
              {%- if cd_mount_product == blank -%}
                {%- assign cd_mount_product = all_products['aiworld-universal-cd-slot-mount-for-9-inch-carplay-screen'] -%}
              {%- endif -%}
              {%- if camera_product == blank -%}
                {%- assign camera_product = all_products['aiworld-1080p-rear-view-backup-camera'] -%}
              {%- endif -%}
              {%- if protection_product == blank -%}
                {%- assign protection_product = all_products['replacement-protection'] -%}
              {%- endif -%}
            {%- endif -%}
            {%- if product.handle == 'wireless-carplay-android-auto-adapter' -%}
              {%- assign cd_mount_product = blank -%}
              {%- assign camera_product = blank -%}
            {%- endif -%}

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
                {%- when 'text' -%}
                  <p
                    class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.text -}}
                  </p>
                {%- when 'aiworld_campaign_badge' -%}
                  {%- if block.settings.enabled and block.settings.label != blank -%}
                    <style>
                      #ProductInfo-{{ section.id }} .aiworld-campaign-badges { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 0 0 10px; }
                      #ProductInfo-{{ section.id }} .aiworld-campaign-badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid #087bf4; border-radius: 4px; background: #087bf4; box-shadow: 0 3px 8px rgba(0, 161, 239, .22); color: #fff; font-size: 12px; font-weight: 400; letter-spacing: .02em; line-height: 1; text-transform: uppercase; }
                      #ProductInfo-{{ section.id }} .aiworld-campaign-badge__icon { display: inline-grid; place-items: center; color: #fff; font-size: 14px; line-height: 1; }
                      #ProductInfo-{{ section.id }} .aiworld-campaign-badge--secondary { border-color: #00cfff; background: #eaf8ff; box-shadow: none; color: #063a63; }
                    </style>
                    <span class="aiworld-campaign-badges" {{ block.shopify_attributes }}>
                      <span class="aiworld-campaign-badge">
                        <span class="aiworld-campaign-badge__icon" aria-hidden="true">⚡</span>
                        <span>{{ block.settings.label | escape }}</span>
                      </span>
                      {% if block.settings.secondary_label != blank %}<span class="aiworld-campaign-badge aiworld-campaign-badge--secondary">{{ block.settings.secondary_label | escape }}</span>{% endif %}
                    </span>
                  {%- endif -%}
                {%- when 'title' -%}
                  {%- assign product_display_title = product.metafields.custom.display_title.value -%}
                  {%- if block.settings.title_override != blank -%}
                    {%- assign product_display_title = block.settings.title_override -%}
                  {%- endif -%}
                  {%- if product_display_title == blank -%}
                    {%- assign product_display_title = product.title -%}
                  {%- endif -%}
                  <div
                    class="product__title"
                    style="--product-title-size: {{ block.settings.desktop_font_size }}px; --product-title-size-mobile: {{ block.settings.mobile_font_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    <h1>{{ product_display_title | strip_html | escape }}</h1>
                    <a href="{{ product.url }}" class="product__title">
                      <h2 class="h1">
                        {{ product_display_title | strip_html | escape }}
                      </h2>
                    </a>
                  </div>
                {%- when 'aiworld_hook' -%}
                  {%- if block.settings.text != blank -%}
                    <style>
                      #ProductInfo-{{ section.id }} .aiworld-product-hook { margin: 0 0 12px; color: var(--buy-muted, #556270); font-size: {{ block.settings.desktop_font_size }}px; font-weight: 400; line-height: 1.4; white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }
                      @media screen and (max-width: 749px) {
                        #ProductInfo-{{ section.id }} .aiworld-product-hook { margin-bottom: 10px; font-size: {{ block.settings.mobile_font_size }}px; }
                      }
                    </style>
                    <p class="aiworld-product-hook" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                {%- when 'price' -%}
                  <div
                    id="price-{{ section.id }}"
                    role="status"
                    style="--product-price-size: {{ block.settings.desktop_price_size }}px; --product-price-size-mobile: {{ block.settings.mobile_price_size }}px; --product-compare-size: {{ block.settings.compare_price_size }}px; --product-badge-size: {{ block.settings.tax_badge_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {%- comment -%}
                      Keep the product price as the variant price only ($99).
                      Addon package totals stay in the addon picker Total row so scrapers do not read $155.90.
                    {%- endcomment -%}
                    {%- render 'price',
                      product: product,
                      use_variant: true,
                      show_badges: block.settings.show_taxes_included,
                      sale_badge_label: 'products.product.taxes_included',
                      show_currency_code: false,
                      price_class: 'price--large'
                    -%}
                  </div>
                  {%- if product.quantity_price_breaks_configured? -%}
                    <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                      <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                    </div>
                  {%- endif -%}
                  <div {{ block.shopify_attributes }}>
                    {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                    {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      {{ form | payment_terms }}
                    {%- endform -%}
                  </div>
                {%- when 'inventory' -%}
                  <p
                    class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                    {{ block.shopify_attributes }}
                    id="Inventory-{{ section.id }}"
                    role="status"
                  >
                    {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                        {%- if product.selected_or_first_available_variant.inventory_quantity
                            <= block.settings.inventory_threshold
                        -%}
                          <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                            {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                          </span>
                          {%- if block.settings.show_inventory_quantity -%}
                            {{-
                              'products.product.inventory_low_stock_show_count'
                              | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                            -}}
                          {%- else -%}
                            {{- 'products.product.inventory_low_stock' | t -}}
                          {%- endif -%}
                        {%- else -%}
                          <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                            {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                          </span>
                          {%- if block.settings.show_inventory_quantity -%}
                            {{-
                              'products.product.inventory_in_stock_show_count'
                              | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                            -}}
                          {%- else -%}
                            {{- 'products.product.inventory_in_stock' | t -}}
                          {%- endif -%}
                        {%- endif -%}
                      {%- else -%}
                        {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                          <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                            {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                          </span>
                          {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                        {%- else -%}
                          <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                            {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                          </span>
                          {{- 'products.product.inventory_out_of_stock' | t -}}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endif -%}
                  </p>
                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                      {{ product.description }}
                    </div>
                  {%- endif -%}
                {%- when 'sku' -%}
                  <p
                    class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                    id="Sku-{{ section.id }}"
                    role="status"
                    {{ block.shopify_attributes }}
                  >
                    <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                    {{- product.selected_or_first_available_variant.sku -}}
                  </p>
                {%- when 'custom_liquid' -%}
                  {{ block.settings.custom_liquid }}
                {%- when 'aiworld_rating' -%}
                  {%- assign rating_value = product.metafields.custom.rating_value.value | default: '4.8' -%}
                  {%- assign rating_count = product.metafields.custom.rating_count.value -%}
                  {%- if block.settings.rating_count != blank -%}
                    {%- assign rating_count = block.settings.rating_count -%}
                  {%- endif -%}
                  {%- if rating_count == blank -%}
                    {%- assign rating_count = '4.74 (891 reviews)' -%}
                  {%- endif -%}
                  <div
                    class="aiworld-product-rating"
                    role="img"
                    aria-label="4.74 out of 5 stars from 891 reviews"
                    style="--rating-stars-size: {{ block.settings.stars_size }}px; --rating-count-size: {{ block.settings.count_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    <span class="aiworld-product-rating__stars" aria-hidden="true">★★★★★</span>
                    {%- if block.settings.show_count -%}
                      <span class="aiworld-product-rating__count">{{ rating_count }}{% if block.settings.count_label != blank %} {{ block.settings.count_label }}{% endif %}</span>
                    {%- endif -%}
                  </div>
                {%- when 'aiworld_shipping_note' -%}
                  {%- assign is_service_addon = false -%}
                  {%- if product.handle == 'replacement-protection' or product.type == 'Protection' or product.type == 'Service' or product.tags contains 'service' -%}
                    {%- assign is_service_addon = true -%}
                  {%- endif -%}
                  {%- if is_service_addon -%}
                    {%- capture shipping_message -%}Service add-on. Coverage starts on <strong>delivery</strong> of the eligible screen - not a shipped item.{%- endcapture -%}
                  {%- else -%}
                    {%- assign shipping_message = product.metafields.custom.shipping_note.value -%}
                    {%- if block.settings.message != blank -%}
                      {%- assign shipping_message = block.settings.message -%}
                    {%- endif -%}
                    {%- if shipping_message == blank -%}
                      {%- capture shipping_message -%}Items Will Arrive Within <strong>1–4 Business Days (US).</strong>{%- endcapture -%}
                    {%- endif -%}
                  {%- endif -%}
                  <div
                    class="aiworld-shipping-note"
                    role="status"
                    style="--shipping-note-size: {{ block.settings.desktop_font_size }}px; --shipping-note-size-mobile: {{ block.settings.mobile_font_size }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.show_icon -%}
                      <span class="aiworld-shipping-note__icon" aria-hidden="true">{{ 'icon-box.svg' | inline_asset_content }}</span>
                    {%- endif -%}
                    <span>{{ shipping_message }}</span>
                  </div>
                {%- when 'aiworld_promo_code' -%}
                  {%- if block.settings.enabled and block.settings.code != blank -%}
                    <style>
                      #ProductInfo-{{ section.id }} .aiworld-promo-code { margin: 10px 0; overflow: hidden; border: 1px solid var(--promo-border); border-radius: var(--promo-radius); background: var(--promo-background); box-shadow: none; filter: none; color: var(--promo-text); }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 12px; background: var(--promo-accent); box-shadow: none; filter: none; color: #fff; font-size: 13px; font-weight: 400; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__bar-offer { display: flex; align-items: center; gap: 8px; min-width: 0; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__badge { display: inline-flex; align-items: center; min-height: 20px; padding: 2px 8px; border: 1px solid rgba(255, 255, 255, .82); border-radius: 999px; background: rgba(255, 255, 255, .22); box-shadow: none; filter: none; color: #fff; font-size: 11px; font-weight: 400; letter-spacing: .04em; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__countdown { margin-left: auto; white-space: nowrap; color: #fff; font-size: 12px; font-variant-numeric: tabular-nums; font-weight: 400; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__body { padding: 12px; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__instruction { display: flex; align-items: center; gap: 7px; margin: 0 0 10px; padding: 8px 10px; border-left: 2px solid #00aee8; border-radius: 4px; background: rgba(0, 181, 255, .1); box-shadow: none; filter: none; color: #064575; font-size: 15px; font-weight: 400; line-height: 1.35; letter-spacing: .01em; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__instruction-mark { color: #008ff0; font-size: 14px; text-shadow: none; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__row { display: flex; min-height: 42px; overflow: hidden; border: 1px solid var(--promo-border); border-radius: 8px; background: #fff; box-shadow: none; filter: none; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code code { display: flex; flex: 1; align-items: center; padding: 0 12px; color: var(--promo-text); font-family: inherit; font-size: 16px; font-weight: 400; letter-spacing: .08em; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__copy { min-width: 80px; border: 0; background: var(--promo-accent); box-shadow: none; filter: none; color: #fff; font: inherit; font-size: 12px; font-weight: 400; cursor: pointer; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__copy:focus-visible { outline: 2px solid var(--promo-text); outline-offset: -4px; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__terms { margin: 10px 0 0; color: #51718a; font-size: 12px; line-height: 1.4; }
                      #ProductInfo-{{ section.id }} .aiworld-promo-code__countdown--mobile { display: none; }
                      @media screen and (max-width: 749px) {
                        #ProductInfo-{{ section.id }} .aiworld-promo-code { border-color: #0787f9; border-radius: 12px; background: #fff; box-shadow: none; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__bar { align-items: center; flex-wrap: nowrap; padding: 9px 12px; background: #0787f9; box-shadow: none; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__bar-offer { gap: 8px; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__bar-offer > span:first-child { font-weight: 700; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__badge { min-height: 18px; padding: 3px 8px; border: 0; border-radius: 4px; background: #111; box-shadow: none; color: #fff; font-weight: 400; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__bar > .aiworld-promo-code__countdown { display: none; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__body { padding: 12px 12px 10px; background: #fffdf8; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__instruction { gap: 6px; margin: 0 0 10px; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; color: #111; font-size: 14px; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__instruction-mark { color: #0787f9; text-shadow: none; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__row { min-height: 40px; border: 1px dashed #0787f9; border-radius: 4px; background: #fff; box-shadow: none; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code code { color: #111; font-size: 15px; font-weight: 400; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__copy { min-width: 56px; border-radius: 0; background: #111; box-shadow: none; font-weight: 400; }
                        #ProductInfo-{{ section.id }} .aiworld-promo-code__countdown--mobile { display: block; margin: 10px 0 0; color: #111; font-size: 12px; font-variant-numeric: tabular-nums; font-weight: 600; line-height: 1.2; }
                      }
                    </style>
                    <aside
                      class="aiworld-promo-code"
                      aria-label="{{ block.settings.label | escape }}"
                      style="--promo-accent: {{ block.settings.accent_color }}; --promo-background: {{ block.settings.background_color }}; --promo-border: {{ block.settings.border_color }}; --promo-text: {{ block.settings.text_color }}; --promo-radius: {{ block.settings.corner_radius }}px;"
                      {{ block.shopify_attributes }}
                    >
                      <div class="aiworld-promo-code__bar">
                        <span class="aiworld-promo-code__bar-offer">
                          <span>{{ block.settings.discount_text | escape }}</span>
                          {% if block.settings.label != blank %}<span class="aiworld-promo-code__badge">{{ block.settings.label | escape }}</span>{% endif %}
                        </span>
                        {% if block.settings.show_countdown and block.settings.countdown_end != blank %}<span class="aiworld-promo-code__countdown" data-aiworld-promo-countdown data-countdown-end="{{ block.settings.countdown_end | escape }}" data-countdown-prefix="{{ block.settings.countdown_prefix | escape }}"></span>{% endif %}
                      </div>
                      <div class="aiworld-promo-code__body">
                        <p class="aiworld-promo-code__instruction"><span class="aiworld-promo-code__instruction-mark" aria-hidden="true">✦</span>{{ block.settings.instruction | escape }}</p>
                        <div class="aiworld-promo-code__row">
                          <code>{{ block.settings.code | escape }}</code>
                          <button class="aiworld-promo-code__copy" type="button" data-aiworld-promo-copy data-code="{{ block.settings.code | escape }}" data-copy-label="{{ block.settings.copy_label | escape }}" data-copied-label="{{ block.settings.copied_label | escape }}">{{ block.settings.copy_label | escape }}</button>
                        </div>
                        {% if block.settings.show_countdown and block.settings.countdown_end != blank %}<span class="aiworld-promo-code__countdown aiworld-promo-code__countdown--mobile" data-aiworld-promo-countdown data-countdown-end="{{ block.settings.countdown_end | escape }}" data-countdown-prefix="{{ block.settings.countdown_prefix | escape }}"></span>{% endif %}
                        {% if block.settings.terms != blank %}<p class="aiworld-promo-code__terms">{{ block.settings.terms | escape }}</p>{% endif %}
                      </div>
                    </aside>
                    <script>
                      window.aiworldPromoCountdownUpdate = () => {
                        document.querySelectorAll('[data-aiworld-promo-countdown]').forEach((countdown) => {
                          const endTime = new Date(countdown.dataset.countdownEnd).getTime();
                          if (Number.isNaN(endTime)) {
                            countdown.hidden = true;
                            return;
                          }
                          const remaining = Math.max(0, endTime - Date.now());
                          if (remaining === 0) {
                            countdown.textContent = 'Offer ended';
                            return;
                          }
                          const totalSeconds = Math.floor(remaining / 1000);
                          const days = Math.floor(totalSeconds / 86400);
                          const hours = Math.floor((totalSeconds % 86400) / 3600);
                          const minutes = Math.floor((totalSeconds % 3600) / 60);
                          const seconds = totalSeconds % 60;
                          const prefix = countdown.dataset.countdownPrefix || 'Ends in:';
                          countdown.textContent = `${prefix} ${days}d : ${String(hours).padStart(2, '0')}h : ${String(minutes).padStart(2, '0')}m : ${String(seconds).padStart(2, '0')}s`;
                        });
                      };
                      window.aiworldPromoCountdownUpdate();
                      if (!window.aiworldPromoCountdownReady) {
                        window.aiworldPromoCountdownReady = true;
                        window.setInterval(() => window.aiworldPromoCountdownUpdate(), 1000);
                        document.addEventListener('shopify:section:load', () => window.aiworldPromoCountdownUpdate());
                      }
                      if (!window.aiworldPromoCopyReady) {
                        window.aiworldPromoCopyReady = true;
                        document.addEventListener('click', async (event) => {
                          const button = event.target.closest('[data-aiworld-promo-copy]');
                          if (!button) return;
                          const code = button.dataset.code;
                          if (!code) return;
                          try {
                            if (navigator.clipboard && window.isSecureContext) {
                              await navigator.clipboard.writeText(code);
                            } else {
                              const field = document.createElement('textarea');
                              field.value = code;
                              field.setAttribute('readonly', '');
                              field.style.position = 'fixed';
                              field.style.opacity = '0';
                              document.body.append(field);
                              field.select();
                              document.execCommand('copy');
                              field.remove();
                            }
                            const originalLabel = button.dataset.copyLabel;
                            button.textContent = button.dataset.copiedLabel || originalLabel;
                            window.setTimeout(() => { button.textContent = originalLabel; }, 1600);
                          } catch (error) {}
                        });
                      }
                    </script>
                  {%- endif -%}
                {%- when 'aiworld_cd_mount_picker' -%}
                  {%- render 'aiworld-cd-mount-picker',
                    product: product,
                    block: block,
                    product_form_id: product_form_id
                  -%}
                {%- when 'aiworld_key_features' -%}
                  {%- assign key_features_heading = product.metafields.custom.key_features_heading.value -%}
                  {%- assign use_adapter_key_features = false -%}
                  {%- if product.handle == 'wireless-carplay-android-auto-adapter' -%}
                    {%- assign use_adapter_key_features = true -%}
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    {%- assign key_features_heading = block.settings.heading -%}
                  {%- endif -%}
                  {%- if key_features_heading == blank -%}
                    {%- assign key_features_heading = 'Key Features' -%}
                  {%- endif -%}
