                    {% if product.handle == '9-inch-wireless-carplay' %}<span aria-hidden="true" class="aiworld-box-toggle"></span></summary>{% endif %}
                    <div class="aiworld-product-key-features__content">
                      {%- if block.settings.features != blank -%}
                        {{ block.settings.features }}
                      {%- elsif product.metafields.custom.key_features != blank -%}
                        {{ product.metafields.custom.key_features | metafield_tag }}
                      {%- elsif use_adapter_key_features -%}
                        <ul>
                          <li>Converts factory-wired Apple CarPlay or Android Auto to wireless.</li>
                          <li>One-time Bluetooth and Wi-Fi pairing with automatic reconnection.</li>
                          <li>Compact adapter designed to stay installed and keep the console clean.</li>
                          <li>Keep compatible factory touchscreen, steering-wheel, and control-knob operation.</li>
                          <li>Simple USB data connection and plug-and-pair setup.</li>
                          <li>Works only with vehicles that already support factory-wired CarPlay or Android Auto.</li>
                        </ul>
                      {%- else -%}
                        <ul>
                          <li>Wireless Apple CarPlay and Android Auto</li>
                          <li>9-inch HD touchscreen</li>
                          <li>1080p rear-view backup camera</li>
                          <li>Plug in and drive, no dashboard replacement</li>
                          <li>Audio by FM, AUX, Bluetooth, or the built-in speaker</li>
                          <li>Works with most 12V and 24V vehicles</li>
                        </ul>
                      {%- endif -%}
                    </div>
                  </{% if product.handle == '9-inch-wireless-carplay' %}details{% else %}section{% endif %}>
                  {% if product.metafields.custom.box_contents.value != blank %}
                    {% render 'aiworld-box-contents', product: product %}
                  {% endif %}
                {%- when 'aiworld_before_buy' -%}
                  {%- assign before_buy_label = product.metafields.custom.before_buy_label.value -%}
                  {%- assign before_buy_requirement = product.metafields.custom.before_buy_requirement.value -%}
                  {%- assign before_buy_details = product.metafields.custom.before_buy_details.value -%}
                  {%- assign before_buy_help_link = product.metafields.custom.before_buy_help_link.value -%}
                  {%- if block.settings.label != blank -%}{%- assign before_buy_label = block.settings.label -%}{%- endif -%}
                  {%- if block.settings.requirement != blank -%}{%- assign before_buy_requirement = block.settings.requirement -%}{%- endif -%}
                  {%- if block.settings.details != blank -%}{%- assign before_buy_details = block.settings.details -%}{%- endif -%}
                  {%- if block.settings.help_link != blank -%}{%- assign before_buy_help_link = block.settings.help_link -%}{%- endif -%}
                  {%- if before_buy_label == blank -%}{%- assign before_buy_label = 'Before You Buy' -%}{%- endif -%}
                  {%- if before_buy_requirement == blank -%}{%- capture before_buy_requirement -%}Independent portable screen for most <strong>12V/24V vehicles</strong>{%- endcapture -%}{%- endif -%}
                  {%- if before_buy_details == blank -%}{%- assign before_buy_details = 'No factory CarPlay required. Use the included charger if the USB port is below 5V/3A.' -%}{%- endif -%}
                  {%- if before_buy_help_link == blank -%}{%- assign before_buy_help_link = routes.root_url | append: 'pages/installation-guide' -%}{%- endif -%}
                  <details
                    class="aiworld-before-buy"
                    {% if block.settings.open_by_default %}open{% endif %}
                    style="--before-buy-summary-size: {{ block.settings.summary_font_size }}px; --before-buy-body-size: {{ block.settings.body_font_size }}px; --before-buy-radius: {{ block.settings.card_radius }}px;"
                    {{ block.shopify_attributes }}
                  >
                    <summary class="aiworld-before-buy__summary">
                      <span class="aiworld-before-buy__icon" aria-hidden="true">i</span>
                      <span class="aiworld-before-buy__copy">
                        <span class="aiworld-before-buy__label">{{ before_buy_label | strip_html | escape }}</span>
                        <span class="aiworld-before-buy__requirement">{{ before_buy_requirement }}</span>
                        <span class="aiworld-before-buy__details">{{ before_buy_details | strip_html | escape }}</span>
                      </span>
                      <span class="aiworld-before-buy__plus" aria-hidden="true"></span>
                    </summary>
                    <div class="aiworld-before-buy__panel">
                      {%- if block.settings.panel_content != blank -%}
                        {{ block.settings.panel_content }}
                      {%- elsif product.metafields.custom.before_buy_content != blank -%}
                        {{ product.metafields.custom.before_buy_content | metafield_tag }}
                      {%- else -%}
                        <div class="aiworld-before-buy__panel-heading"><span class="aiworld-before-buy__panel-heading-icon" aria-hidden="true">&#10003;</span><strong>{{ before_buy_label | strip_html | escape }}</strong></div>
                        <ul class="aiworld-before-buy__checklist">
                          <li><strong>Power:</strong> The screen needs a stable <span class="aiworld-before-buy__value">5V/3A</span> input. The included charger converts <span class="aiworld-before-buy__value">12V–24V</span> to <span class="aiworld-before-buy__value">5V/3A</span>. A vehicle USB port around <span class="aiworld-before-buy__value">5V/0.5A–1A</span> can leave the screen off, restarting, freezing, or unstable.</li>
                          <li><strong>Compatibility:</strong> Independent portable screen. No factory CarPlay is required. It fits many older <span class="aiworld-before-buy__value">12V/24V</span> vehicles when the included charger is used.</li>
                          <li><strong>Audio:</strong> Choose FM, AUX, the built-in speaker (Home Mode), or Bluetooth through CarPlay/Android Auto. FM needs an unused local frequency. If FM is noisy, use AUX.</li>
                          <li><strong>Internet:</strong> Wireless CarPlay/Android Auto needs mobile data. Do not connect the phone to another Wi-Fi network or hotspot, and keep it within about <span class="aiworld-before-buy__value">5 meters</span>.</li>
                          <li><strong>Video playback:</strong> Online video playback is not supported, including YouTube and Netflix. Screen mirroring can project your phone onto this screen, but smoothness depends on the phone and network.</li>
                          <li><strong>CarPlay and Android Auto:</strong> Netflix, YouTube, and TikTok cannot be played natively through CarPlay or Android Auto. Mirroring may be available depending on the phone and operating system.</li>
                        </ul>
                        <div class="aiworld-before-buy__notice"><span aria-hidden="true">i</span><p>Confirm a safe <span class="aiworld-before-buy__value">9-inch</span> mounting space, and check the USB output before ordering.</p></div>
                      {%- endif -%}
                      {%- if block.settings.show_help_link -%}
                        <a class="aiworld-before-buy__help-link" href="{{ before_buy_help_link }}">{{ block.settings.help_text }} &#8594;</a>
                      {%- endif -%}
                    </div>
                  </details>
                {%- when 'collapsible_tab' -%}
                  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
