                    {% if product.handle == '9-inch-wireless-carplay' %}open{% endif %}
                    style="--key-features-size: {{ block.settings.desktop_font_size }}px; --key-features-size-mobile: {{ block.settings.mobile_font_size }}px; --key-features-radius: {{ block.settings.card_radius }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {% if product.handle == '9-inch-wireless-carplay' %}<summary class="aiworld-box-summary">{% endif %}
