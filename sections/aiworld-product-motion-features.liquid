{%- if section.blocks.size > 0 -%}
  <section class="aw-motion-features color-{{ section.settings.color_scheme }}" aria-label="{{ section.settings.aria_label | escape }}">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <header class="aw-motion-features__header">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="aw-motion-features__list">
      {%- for block in section.blocks -%}
        <article class="aw-motion-feature" {{ block.shopify_attributes }}>
          <div class="aw-motion-feature__media">
            {%- if block.settings.video_asset != blank and block.settings.poster_asset != blank -%}
              <div class="aw-motion-feature__video-wrap">
                <video
                  class="aw-motion-feature__video"
                  muted
                  playsinline
                  preload="none"
                  poster="{{ block.settings.poster_asset | asset_url }}"
                  aria-label="{{ block.settings.video_label | escape }}"
                  data-motion-video
                >
                  <source data-src="{{ block.settings.video_asset | asset_url }}" type="video/mp4">
                </video>
                <button class="aw-motion-feature__toggle" type="button" aria-label="Play {{ block.settings.video_label | escape }}" aria-pressed="false" data-motion-toggle>
                  <span data-motion-toggle-label>Play</span>
                </button>
                <noscript>
                  <a class="aw-motion-feature__fallback" href="{{ block.settings.video_asset | asset_url }}">Watch {{ block.settings.video_label | escape }}</a>
                </noscript>
              </div>
            {%- endif -%}
          </div>

          <div class="aw-motion-feature__copy">
            {%- if block.settings.eyebrow != blank -%}
              <p class="aw-motion-feature__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte aw-motion-feature__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .aw-motion-features { background: #fff; color: #101828; }
  .aw-motion-features__header { max-width: 680px; margin: 0 auto; padding: 48px 20px; text-align: center; }
  .aw-motion-features__header h2 { margin: 0; color: #101828; font-size: clamp(2.4rem, 4vw, 4.2rem); line-height: 1.1; }
  .aw-motion-features__header .rte { margin-top: 14px; color: #4b5565; }
  .aw-motion-feature { position: relative; min-height: 100svh; overflow: hidden; background: #06182a; }
  .aw-motion-feature__media, .aw-motion-feature__video-wrap, .aw-motion-feature__video { position: absolute; inset: 0; width: 100%; height: 100%; }
  .aw-motion-feature__video-wrap { background: #06182a; }
  .aw-motion-feature__video { display: block; object-fit: cover; }
  .aw-motion-feature__copy { position: absolute; z-index: 1; left: clamp(20px, 7vw, 112px); bottom: clamp(24px, 8vw, 104px); max-width: min(540px, calc(100% - 40px)); padding: clamp(18px, 2.3vw, 32px); background: #06182a; color: #fff; }
  .aw-motion-feature__eyebrow { margin: 0 0 10px; color: #0ca6ff; font-size: 1.2rem; font-weight: 700; letter-spacing: .12em; line-height: 1.25; text-transform: uppercase; }
  .aw-motion-feature h3 { margin: 0; color: #fff; font-size: clamp(2.6rem, 4vw, 5.4rem); line-height: 1.06; letter-spacing: -.035em; }
  .aw-motion-feature__text { margin-top: 18px; color: #fff; font-size: 1.65rem; line-height: 1.55; }
  .aw-motion-feature__toggle { position: absolute; z-index: 2; right: clamp(16px, 3vw, 48px); bottom: clamp(16px, 3vw, 48px); min-width: 76px; min-height: 40px; padding: 8px 14px; border: 1px solid #fff; border-radius: 8px; background: #fff; color: #06182a; font: inherit; font-size: 1.3rem; font-weight: 700; line-height: 1; cursor: pointer; }
  .aw-motion-feature__toggle:focus-visible { outline: 2px solid #101828; outline-offset: 3px; }
  .aw-motion-feature__fallback { position: absolute; z-index: 2; right: 16px; bottom: 16px; padding: 10px 14px; border-radius: 8px; background: #fff; color: #06182a; font-size: 1.3rem; font-weight: 700; text-decoration: none; }
  @media screen and (max-width: 749px) {
    .aw-motion-features__header { padding: 36px 20px; text-align: left; }
    .aw-motion-feature { min-height: 100svh; }
    .aw-motion-feature__copy { left: 16px; right: 16px; bottom: 24px; max-width: none; padding: 18px; }
    .aw-motion-feature__text { margin-top: 13px; font-size: 1.5rem; }
    .aw-motion-feature__toggle { right: 16px; bottom: 16px; }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const init = () => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const videos = document.querySelectorAll('[data-motion-video]');

      const setButtonState = (video, state) => {
        const button = video.parentElement.querySelector('[data-motion-toggle]');
        const label = button.querySelector('[data-motion-toggle-label]');
        const action = state === 'playing' ? 'Pause' : state === 'ended' ? 'Replay' : 'Play';
        button.setAttribute('aria-pressed', String(state === 'playing'));
        button.setAttribute('aria-label', `${action} ${video.getAttribute('aria-label')}`);
        label.textContent = action;
      };

      const loadVideo = (video) => {
        const source = video.querySelector('source[data-src]');
        if (!source.getAttribute('src')) {
          source.setAttribute('src', source.dataset.src);
          video.load();
        }
      };

      const playVideo = (video) => {
        if (video.dataset.motionPlayed === 'true') return;
        loadVideo(video);
        if (!reducedMotion) {
          video.play().catch(() => setButtonState(video, 'paused'));
        }
      };

      videos.forEach((video) => {
        const button = video.parentElement.querySelector('[data-motion-toggle]');
        setButtonState(video, 'paused');
        video.addEventListener('play', () => setButtonState(video, 'playing'));
        video.addEventListener('pause', () => {
          if (!video.ended) setButtonState(video, 'paused');
        });
        video.addEventListener('ended', () => {
          video.dataset.motionPlayed = 'true';
          setButtonState(video, 'ended');
        });
        button.addEventListener('click', () => {
          if (video.ended || video.dataset.motionPlayed === 'true') {
            video.currentTime = 0;
            video.dataset.motionPlayed = 'false';
          }
          if (video.paused) {
            loadVideo(video);
            video.play().catch(() => setButtonState(video, 'paused'));
          } else {
            video.pause();
          }
        });
      });

      if (!('IntersectionObserver' in window)) {
        videos.forEach(playVideo);
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (entry.isIntersecting) {
            playVideo(video);
          } else if (!video.paused) {
            video.pause();
          }
        });
      }, { threshold: 0.45 });

      videos.forEach((video) => observer.observe(video));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Product motion features",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label",
      "default": "Product motion features"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it in motion"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A closer look at the features that make every drive easier.</p>"
    }
  ],
  "blocks": [
    {
      "type": "motion",
      "name": "Motion feature",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "video_asset",
          "label": "Video asset filename",
          "info": "Use the filename from this theme's Assets folder."
        },
        {
          "type": "text",
          "id": "poster_asset",
          "label": "Poster image asset filename",
          "info": "Use the filename from this theme's Assets folder."
        },
        {
          "type": "text",
          "id": "video_label",
          "label": "Video description"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Media position",
          "default": "media_right",
          "options": [
            { "value": "media_right", "label": "Right" },
            { "value": "media_left", "label": "Left" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product motion features"
    }
  ]
}
{% endschema %}
