<section class="trade-faq" style="padding-top:{% if section.settings.enable_top_spacing == false %}0{% else %}{{ section.settings.padding_top }}{% endif %}px;padding-bottom:{% if section.settings.enable_bottom_spacing == false %}0{% else %}{{ section.settings.padding_bottom }}{% endif %}px;background:{{ section.settings.background }};"><div class="trade-container trade-faq__grid"><div class="trade-faq__intro"><p class="trade-kicker">{{ section.settings.kicker }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}{% if section.settings.link_label != blank %} <a class="trade-faq__inline-link" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.link_label }} →</a> for more.{% endif %}</p></div><div>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{{ block.settings.answer }}</p></details>{% endfor %}</div></div></section>
{% schema %}
{"name":"首页常见问题","tag":"section","class":"section-aiworld-trade-faq","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"FREQUENTLY ASKED QUESTIONS"},{"type":"text","id":"heading","label":"Heading","default":"Got Questions?"},{"type":"text","id":"text","label":"Text","default":"Here are some answers. View all FAQs for more."},{"type":"text","id":"link_label","label":"Link label","default":"View All FAQs"},{"type":"url","id":"link","label":"Link"},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"checkbox","id":"enable_top_spacing","label":"Enable top spacing","default":true},{"type":"range","id":"padding_top","min":0,"max":120,"step":4,"unit":"px","label":"Top spacing","default":48},{"type":"checkbox","id":"enable_bottom_spacing","label":"Enable bottom spacing","default":true},{"type":"range","id":"padding_bottom","min":0,"max":120,"step":4,"unit":"px","label":"Bottom spacing","default":48}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Will it work with my car?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>AIWORLD Screen X10 works with most cars, trucks and SUVs with a 12V–24V power outlet.</p>"}]}],"max_blocks":10,"presets":[{"name":"首页常见问题","blocks":[{"type":"question","settings":{"question":"Will it work with my car?"}},{"type":"question","settings":{"question":"Can I connect a backup camera?","answer":"<p>Yes. The system supports compatible backup cameras.</p>"}},{"type":"question","settings":{"question":"Is installation difficult?","answer":"<p>No. It is designed for plug-and-play installation.</p>"}},{"type":"question","settings":{"question":"Does it support both wireless CarPlay and Android Auto?","answer":"<p>Yes, both are supported.</p>"}},{"type":"question","settings":{"question":"How does the audio work?","answer":"<p>Use the built-in speaker, FM transmitter or AUX output.</p>"}}]}]}
{% endschema %}
