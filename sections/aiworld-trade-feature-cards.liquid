<section class="trade-cards" style="--section-bg:{{ section.settings.background }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"><div class="trade-container"><div class="trade-head"><p class="trade-kicker">{{ section.settings.kicker }}</p><h2 class="trade-heading">{{ section.settings.heading }}</h2><p class="trade-subheading">{{ section.settings.subheading }}</p></div><div class="trade-card-grid" style="--columns:{{ section.settings.columns }};">{% for block in section.blocks %}<article class="trade-card" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="trade-card__media">{{ block.settings.image | image_url: width:800 | image_tag: loading:'lazy', widths:'360,540,800', sizes:'(min-width:990px) 16vw, 50vw', alt:block.settings.title | escape }}</div>{% endif %}<div class="trade-card__copy"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"AIWORLD feature cards","tag":"section","class":"section-aiworld-trade-feature-cards","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"WHY CHOOSE AIWORLD"},{"type":"text","id":"heading","label":"Heading","default":"The All-In-One Driving Upgrade"},{"type":"text","id":"subheading","label":"Subheading","default":"AIWORLD Screen X10 brings modern connectivity, a larger and safer display, and a better driving experience to any vehicle."},{"type":"color","id":"background","label":"Background","default":"#f5f9fd"},{"type":"range","id":"columns","min":2,"max":6,"step":1,"label":"Columns","default":6},{"type":"range","id":"padding_top","min":0,"max":120,"step":4,"unit":"px","label":"Top spacing","default":48},{"type":"range","id":"padding_bottom","min":0,"max":120,"step":4,"unit":"px","label":"Bottom spacing","default":48}],"blocks":[{"type":"card","name":"Feature card","settings":[{"type":"image_picker","id":"image","label":"Image (recommended 800 × 506 px)","info":"建议图片尺寸：800 × 506 px"},{"type":"text","id":"title","label":"Title","default":"10.26 HD Display"},{"type":"textarea","id":"text","label":"Text","default":"Crisp, vibrant, and easy to see - even in bright sunlight."}]}],"max_blocks":8,"presets":[{"name":"AIWORLD feature cards","blocks":[{"type":"card","settings":{"title":"10.26 HD Display","text":"Crisp, vibrant, and easy to see - even in bright sunlight."}},{"type":"card","settings":{"title":"Wireless Connectivity","text":"Wireless CarPlay and Android Auto. Get in and go."}},{"type":"card","settings":{"title":"Easy Installation","text":"Plug and play. No professional install required."}},{"type":"card","settings":{"title":"Voice Assistant Ready","text":"Use Siri or Google Assistant hands-free control."}},{"type":"card","settings":{"title":"Backup Camera Support","text":"Drive and park with confidence."}},{"type":"card","settings":{"title":"A Cleaner, Smarter Car","text":"Modernize any vehicle with a sleek, portable design."}}]}]}
{% endschema %}
