{% doc %}
Renders one slide for the AIWORLD hero carousel.

@param {image} image - Slide image
@param {image} [mobile_image] - Optional mobile slide image
@param {string} eyebrow - Eyebrow text
@param {string} heading - Slide heading
@param {string} text - Slide copy
@param {boolean} show_rating - Whether to show the rating
@param {string} rating_text - Rating text
@param {string} price - Price text
@param {string} button_label - Primary button label
@param {string} button_link - Primary button URL
@param {string} button_2_label - Secondary button label
@param {string} button_2_link - Secondary button URL
@param {number} slide_index - Zero-based slide index
@param {number} slide_count - Total slide count
@param {boolean} is_active - Whether the slide is active
@param {string} shopify_attributes - Theme editor attributes
@param {string} heading_alt - Accessible image alt text
@param {string} overlay_style - Overlay style
{% enddoc %}

<article class="trade-hero__slide{% if is_active %} is-active{% endif %}" data-slide-index="{{ slide_index }}" role="group" aria-roledescription="slide" aria-label="{{ slide_index | plus: 1 }} of {{ slide_count }}" aria-hidden="{% if is_active %}false{% else %}true{% endif %}" {{ shopify_attributes }}>
  <div class="trade-hero__media">
    {% if image != blank %}
      {% if mobile_image != blank %}
        <picture>
          <source media="(max-width: 640px)" srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1000 }} 1000w" sizes="100vw">
          {{ image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: heading_alt | escape }}
        </picture>
      {% else %}
        {{ image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: heading_alt | escape }}
      {% endif %}
    {% endif %}
  </div>
  <div class="trade-hero__overlay trade-hero__overlay--{{ overlay_style }}"></div>
  <div class="trade-hero__content">
    <div class="trade-hero__copy">
      <div class="trade-hero__eyebrow">{{ eyebrow }}</div>
      <h1 class="trade-hero__title">
        {% assign heading_lines = heading | newline_to_br | split: '<br />' %}
        {% for heading_line in heading_lines %}
          <span{% if forloop.last and heading_lines.size > 1 %} class="trade-hero__title-accent"{% endif %}>{{ heading_line }}</span>
          {% unless forloop.last %}<br>{% endunless %}
        {% endfor %}
      </h1>
      <div class="trade-hero__text">{{ text }}</div>
      {% if show_rating %}
        <div class="trade-hero__rating">★★★★★ <span>{{ rating_text }}</span></div>
      {% endif %}
      <div class="trade-hero__price">{{ price }}</div>
      <div class="trade-actions">
        {% if button_label != blank %}
          <a class="trade-button trade-button--blue" href="{{ button_link | default: routes.all_products_collection_url }}">{{ button_label }} →</a>
        {% endif %}
        {% if button_2_label != blank %}
          <a class="trade-button trade-button--outline" href="{{ button_2_link | default: routes.all_products_collection_url }}">{{ button_2_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</article>
