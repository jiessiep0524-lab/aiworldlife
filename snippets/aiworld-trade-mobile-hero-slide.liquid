{% doc %}
Renders one slide for the AIWORLD mobile-first hero alternative.

@param {image} image - Desktop slide image
@param {image} [mobile_image] - Optional mobile slide image
@param {string} eyebrow - Eyebrow text
@param {string} heading - Slide heading
@param {string} text - Slide copy
@param {boolean} show_features - Whether to show feature highlights
@param {string} feature_1_icon - First feature icon label
@param {string} feature_1_title - First feature title
@param {string} feature_1_text - First feature text
@param {string} feature_2_icon - Second feature icon label
@param {string} feature_2_title - Second feature title
@param {string} feature_2_text - Second feature text
@param {string} feature_3_icon - Third feature icon label
@param {string} feature_3_title - Third feature title
@param {string} feature_3_text - Third feature text
@param {boolean} show_rating - Whether to show the rating
@param {string} rating_text - Rating text
@param {string} price - Price text
@param {string} button_label - Primary button label
@param {string} button_link - Primary button URL
@param {string} button_2_label - Secondary button label
@param {string} button_2_link - Secondary button URL
@param {number} slide_index - Zero-based slide index
@param {number} slide_count - Total slide count
@param {boolean} is_active - Whether the slide is active
@param {string} shopify_attributes - Theme editor attributes
{% enddoc %}

<article class="trade-mobile-hero__slide{% if is_active %} is-active{% endif %}" data-slide-index="{{ slide_index }}" role="group" aria-roledescription="slide" aria-label="{{ slide_index | plus: 1 }} of {{ slide_count }}" aria-hidden="{% if is_active %}false{% else %}true{% endif %}" {{ shopify_attributes }}>
  <div class="trade-mobile-hero__media">
    {% assign primary_image = image | default: mobile_image %}
    {% if primary_image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source media="(max-width: 640px)" srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1000 }} 1000w" sizes="100vw">
        {% endif %}
        {{ primary_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750,1100,1500,2000,2400', sizes: '100vw', alt: heading | strip_html | escape }}
      </picture>
    {% endif %}
  </div>
  <div class="trade-mobile-hero__shade" aria-hidden="true"></div>
  <div class="trade-mobile-hero__content">
    <div class="trade-mobile-hero__copy">
      {% if eyebrow != blank %}<div class="trade-mobile-hero__eyebrow">{{ eyebrow }}</div>{% endif %}
      <h2 class="trade-mobile-hero__title">
        {% assign heading_lines = heading | newline_to_br | split: '<br />' %}
        {% for heading_line in heading_lines %}
          <span{% if forloop.last and heading_lines.size > 1 %} class="trade-mobile-hero__title-accent"{% endif %}>{{ heading_line }}</span>
        {% endfor %}
      </h2>
      {% if text != blank %}<div class="trade-mobile-hero__text">{{ text }}</div>{% endif %}

      {% if show_features %}
        {% if feature_1_title != blank or feature_2_title != blank or feature_3_title != blank %}
          <div class="trade-mobile-hero__features">
            {% if feature_1_title != blank %}<div class="trade-mobile-hero__feature"><span class="trade-mobile-hero__feature-icon" aria-hidden="true">{{ feature_1_icon }}</span><strong>{{ feature_1_title }}</strong>{% if feature_1_text != blank %}<small>{{ feature_1_text }}</small>{% endif %}</div>{% endif %}
            {% if feature_2_title != blank %}<div class="trade-mobile-hero__feature"><span class="trade-mobile-hero__feature-icon" aria-hidden="true">{{ feature_2_icon }}</span><strong>{{ feature_2_title }}</strong>{% if feature_2_text != blank %}<small>{{ feature_2_text }}</small>{% endif %}</div>{% endif %}
            {% if feature_3_title != blank %}<div class="trade-mobile-hero__feature"><span class="trade-mobile-hero__feature-icon" aria-hidden="true">{{ feature_3_icon }}</span><strong>{{ feature_3_title }}</strong>{% if feature_3_text != blank %}<small>{{ feature_3_text }}</small>{% endif %}</div>{% endif %}
          </div>
        {% endif %}
      {% endif %}

      {% if show_rating %}<div class="trade-mobile-hero__rating"><span aria-hidden="true">★★★★★</span>{% if rating_text != blank %}<small>{{ rating_text }}</small>{% endif %}</div>{% endif %}
      {% if price != blank %}<div class="trade-mobile-hero__price">{{ price }}</div>{% endif %}
      <div class="trade-mobile-hero__actions">
        {% if button_label != blank %}<a class="trade-button trade-button--blue" href="{{ button_link | default: routes.all_products_collection_url }}">{{ button_label }} <span aria-hidden="true">&#8594;</span></a>{% endif %}
        {% if button_2_label != blank %}<a class="trade-button trade-button--outline" href="{{ button_2_link | default: routes.all_products_collection_url }}">{{ button_2_label }} <span aria-hidden="true">&#8594;</span></a>{% endif %}
      </div>
    </div>
  </div>
</article>
